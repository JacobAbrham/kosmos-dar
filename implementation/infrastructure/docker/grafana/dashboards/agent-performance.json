{
  "dashboard": {
    "title": "KOSMOS Agent Performance",
    "tags": ["kosmos", "agents"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Agent Executions",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kosmos_agent_executions_total[5m])",
            "legendFormat": "{{agent_id}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Agent Execution Duration (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(kosmos_agent_execution_duration_seconds_bucket[5m]))",
            "legendFormat": "{{agent_id}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Agent Failures",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kosmos_agent_executions_failed_total[5m])",
            "legendFormat": "{{agent_id}} - {{error_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Top Agents by Execution Count",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum by (agent_id) (kosmos_agent_executions_total))",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      }
    ]
  }
}
