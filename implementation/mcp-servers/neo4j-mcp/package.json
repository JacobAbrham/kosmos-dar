{
  "name": "@kosmos/neo4j-mcp",
  "version": "1.0.0",
  "description": "Neo4j MCP Server for KOSMOS - Graph database operations with Cypher queries",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
