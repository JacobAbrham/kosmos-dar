{
  "dashboard": {
    "title": "KOSMOS MCP Server Health",
    "tags": ["kosmos", "mcp"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "MCP Server Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "kosmos_mcp_server_health",
            "legendFormat": "{{server}}"
          }
        ],
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Circuit Breaker States",
        "type": "graph",
        "targets": [
          {
            "expr": "kosmos_mcp_circuit_breaker_state",
            "legendFormat": "{{server}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 3,
        "title": "Tool Call Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kosmos_mcp_tool_calls_total[5m])",
            "legendFormat": "{{server}}/{{tool}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 4,
        "title": "Tool Call Latency (95th percentile)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(kosmos_mcp_tool_call_duration_seconds_bucket[5m]))",
            "legendFormat": "{{server}}/{{tool}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 5,
        "title": "Tool Call Failures",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kosmos_mcp_tool_calls_total{status=\"failed\"}[5m])",
            "legendFormat": "{{server}}/{{tool}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
      }
    ]
  }
}
