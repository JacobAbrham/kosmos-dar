# KOSMOS V2.0 Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# CORE SETTINGS
# =============================================================================
KOSMOS_ENV=development
KOSMOS_DEBUG=true
KOSMOS_LOG_LEVEL=INFO
KOSMOS_SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kosmos
POSTGRES_USER=kosmos
POSTGRES_PASSWORD=kosmos_dev_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# CACHE (Dragonfly/Redis)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# =============================================================================
# MESSAGE QUEUE (NATS)
# =============================================================================
NATS_HOST=localhost
NATS_PORT=4222
NATS_URL=nats://${NATS_HOST}:${NATS_PORT}

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=kosmos

# =============================================================================
# AUTHENTICATION (Zitadel)
# =============================================================================
# Zitadel OIDC configuration
ZITADEL_DOMAIN=localhost:8080
ZITADEL_PROJECT_ID=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Internal Zitadel configuration (for docker-compose)
# WARNING: Change these in production!
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_DB_USER=zitadel_user
ZITADEL_DB_PASSWORD=change_in_production
ZITADEL_ADMIN_USERNAME=admin@kosmos.local
ZITADEL_ADMIN_PASSWORD=change_in_production

# JWT Configuration (for custom auth service)
JWT_SECRET=your-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# SECRETS MANAGEMENT (Infisical)
# =============================================================================
INFISICAL_URL=http://localhost:8090
INFISICAL_TOKEN=

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
KOSMOS_OPENAI_API_KEY=${OPENAI_API_KEY}

# Anthropic API Key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
KOSMOS_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# HuggingFace API Key (optional - for embeddings)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# LiteLLM Router (unified LLM gateway)
LITELLM_MASTER_KEY=sk-litellm-master-key-change-in-production
LITELLM_URL=http://localhost:4000
LITELLM_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/litellm

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Jaeger
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# =============================================================================
# MCP SERVERS
# =============================================================================
# Enable/disable specific MCP servers
MCP_MEMORY_ENABLED=true
MCP_MEMORY_FILE_PATH=./data/memory.jsonl
MCP_SEQUENTIAL_THINKING_ENABLED=true
MCP_CONTEXT7_ENABLED=true

# MCP server base paths (relative to backend directory)
MCP_SERVERS_BASE_PATH=../mcp-servers

# =============================================================================
# AGENT SETTINGS
# =============================================================================
# Zeus (orchestrator) configuration
ZEUS_MAX_ITERATIONS=10
ZEUS_TIMEOUT_SECONDS=120

# Pentarchy (governance) configuration
PENTARCHY_VOTE_TIMEOUT_SECONDS=30
PENTARCHY_VOTING_AGENTS=hermes,aegis,athena

# Agent defaults
AGENT_MAX_RETRIES=3
AGENT_CIRCUIT_BREAKER_THRESHOLD=5
AGENT_CIRCUIT_BREAKER_TIMEOUT=60

# =============================================================================
# COST GOVERNANCE
# =============================================================================
# Auto-approve operations under $50
COST_AUTO_APPROVE_MAX=50

# Operations $50-$100 require Pentarchy vote
COST_PENTARCHY_VOTE_MAX=100

# Daily spending limit (USD)
COST_DAILY_LIMIT=500

# Monthly spending limit (USD)
COST_MONTHLY_LIMIT=10000

# Alert thresholds (percentage of limits)
COST_WARNING_THRESHOLD=80
COST_CRITICAL_THRESHOLD=95

# =============================================================================
# SEMANTIC ROUTING
# =============================================================================
# Embedding model for intent classification
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_CACHE_TTL=3600

# Intent routing confidence thresholds
INTENT_HIGH_CONFIDENCE_THRESHOLD=0.85
INTENT_MEDIUM_CONFIDENCE_THRESHOLD=0.70
INTENT_LOW_CONFIDENCE_THRESHOLD=0.50

# =============================================================================
# WORKFLOW AUTOMATION
# =============================================================================
# Enable workflow recording and pattern detection
WORKFLOW_RECORDING_ENABLED=true
WORKFLOW_PATTERN_MIN_OCCURRENCES=3
WORKFLOW_AUTOMATION_SUGGESTIONS_ENABLED=true

# =============================================================================
# FRONTEND
# =============================================================================
# Backend API URL (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# App configuration
NEXT_PUBLIC_APP_NAME=KOSMOS
NEXT_PUBLIC_APP_VERSION=2.0.0-alpha

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Enable detailed SQL logging
SQL_ECHO=false

# Enable API docs (Swagger/OpenAPI)
API_DOCS_ENABLED=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# When KOSMOS_ENV=production, ensure you set:
# - All *_PASSWORD variables to strong, unique passwords
# - All *_KEY and *_SECRET variables to cryptographically secure random values
# - JWT_SECRET to a strong random string (min 32 characters)
# - CORS_ORIGINS to your actual frontend domain(s)
# - API_DOCS_ENABLED=false (for security)
# - SQL_ECHO=false
# - KOSMOS_DEBUG=false
