# ============================================================================
# KOSMOS Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
# Options: development | staging | production

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# Database
DATABASE_URL=postgresql://kosmos:kosmos_dev_password@localhost:5432/kosmos
POSTGRES_PASSWORD=kosmos_dev_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# AI/LLM Configuration
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model serving (SGLang)
SGLANG_BASE_URL=http://localhost:30000

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# GitHub (for integrations)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (Calendar, Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Logging
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# Sentry (error tracking)
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Production Only
# -----------------------------------------------------------------------------
# Domain
DOMAIN=kosmos.nuvanta-holding.com

# SSL (Let's Encrypt)
LETSENCRYPT_EMAIL=admin@nuvanta-holding.com

# Alibaba Cloud
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_REGION=me-central-1
