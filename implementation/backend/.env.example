# =============================================================================
# KOSMOS V2.0 Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
KOSMOS_ENV=development
# Options: development | staging | production

# Debug mode (enables API docs, verbose logging)
KOSMOS_DEBUG=true

# Logging level
KOSMOS_LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key for general encryption (change in production!)
KOSMOS_SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kosmos
POSTGRES_USER=kosmos
POSTGRES_PASSWORD=kosmos_dev_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Cache (Redis/Dragonfly)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# -----------------------------------------------------------------------------
# Message Queue (NATS)
# -----------------------------------------------------------------------------
NATS_HOST=localhost
NATS_PORT=4222
NATS_URL=nats://${NATS_HOST}:${NATS_PORT}

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# HuggingFace (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# LiteLLM Router (unified LLM gateway)
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Langfuse (LLM observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# OpenTelemetry / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# -----------------------------------------------------------------------------
# Authentication (Zitadel)
# -----------------------------------------------------------------------------
ZITADEL_DOMAIN=localhost:8080
ZITADEL_PROJECT_ID=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# Zeus (orchestrator)
ZEUS_MAX_ITERATIONS=10
ZEUS_TIMEOUT_SECONDS=120

# Pentarchy (governance)
PENTARCHY_VOTE_TIMEOUT_SECONDS=30
PENTARCHY_VOTING_AGENTS=hermes,aegis,athena

# General agent settings
AGENT_MAX_RETRIES=3
AGENT_CIRCUIT_BREAKER_THRESHOLD=5
AGENT_CIRCUIT_BREAKER_TIMEOUT=60

# -----------------------------------------------------------------------------
# Cost Governance
# -----------------------------------------------------------------------------
COST_AUTO_APPROVE_MAX=50
COST_PENTARCHY_VOTE_MAX=100
COST_DAILY_LIMIT=500
COST_MONTHLY_LIMIT=10000

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# API documentation (disable in production)
API_DOCS_ENABLED=true

# -----------------------------------------------------------------------------
# MCP Servers
# -----------------------------------------------------------------------------
MCP_SERVERS_BASE_PATH=../mcp-servers
MCP_MEMORY_ENABLED=true
MCP_SEQUENTIAL_THINKING_ENABLED=true
